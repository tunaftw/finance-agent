# PodStock .gitignore

# =============================================================================
# Python
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# ruff
.ruff_cache/

# =============================================================================
# PodStock Specific
# =============================================================================

# Ljudfiler (stora, kan laddas ner igen med 'podstock download')
data/audio/
*.mp3
data/podcasts/raw/*/audio/

# SQLite database (can be regenerated with 'podstock db init && podstock db load')
data/podstock.db

# Generated dashboard (too large for GitHub, regenerate with 'podstock dashboard generate')
data/dashboard/
data/podstock.db-journal
data/podstock.db-wal
data/podstock.db-shm

# =============================================================================
# Dashboard och stora filer
# Se: docs/plans/2026-01-15-website-pipeline-redesign.md
# =============================================================================

# VIKTIGT: index.html MÅSTE genereras med --no-embed för att vara <1MB
# Verification gate i orchestrate-podcast-publish kontrollerar storleken
# Om filen är >1MB, kör: podstock dashboard generate --no-embed

# Empty/legacy database files
data/analyses.db
data/database.db

# Financial filings PDFs (large, download on-demand with 'podstock filings sync')
# Metadata and analysis results are tracked in git
data/filings/raw/

# Temporary files
*.tmp
*.temp
.DS_Store

# Editor files
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Logs
*.log
logs/*
!logs/orchestration/

# =============================================================================
# Secrets (should never be committed)
# =============================================================================

# API keys
.env.local
.env.*.local
secrets.json
*.pem
*.key

# =============================================================================
# OS Generated
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
tools/apple-transcripts/bearer_token.txt
.worktrees/
